<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="NockMon.Board.WidgetHost"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid
        x:Name="Root"
        PointerEntered="OnRootPointerEntered"
        PointerExited="OnRootPointerExited"
        Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            x:Name="TitleText"
            Margin="8,4,24,0"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Style="{StaticResource CaptionTextBlockStyle}"
            TextTrimming="CharacterEllipsis" />

        <ContentPresenter x:Name="Body" Grid.Row="1" />

        <!-- Help: shown while the pointer is over the widget (not in edit mode). Hover: summary; click: pinned details. -->
        <Border
            x:Name="HelpButton"
            Grid.RowSpan="2"
            Width="18"
            Height="18"
            Margin="0,3,4,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Background="Transparent"
            IsHitTestVisible="False"
            Opacity="0"
            Tapped="OnHelpTapped">
            <FontIcon
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Glyph="&#xE9CE;" />
        </Border>

        <!-- Edit mode: covers the content (no interaction with it), drag anywhere to move, grip to resize. -->
        <Grid
            x:Name="EditOverlay"
            Grid.RowSpan="2"
            Background="Transparent"
            BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
            BorderThickness="2"
            CornerRadius="6"
            PointerCaptureLost="OnPointerCaptureLost"
            PointerEntered="OnMoveSurfaceEntered"
            PointerMoved="OnPointerMoved"
            PointerPressed="OnMoveSurfacePressed"
            PointerReleased="OnPointerReleased"
            PointerWheelChanged="OnEditWheel"
            Visibility="Collapsed">
            <StackPanel
                Margin="4"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Orientation="Horizontal"
                PointerEntered="OnButtonsEntered"
                PointerExited="OnButtonsExited"
                Spacing="2">
                <Button
                    x:Name="UnstackButton"
                    Padding="6,4"
                    Click="OnUnstackClick"
                    AutomationProperties.Name="Unstack the shown widget"
                    ToolTipService.ToolTip="Unstack the shown widget"
                    Visibility="Collapsed">
                    <FontIcon FontSize="12" Glyph="&#xE8A7;" />
                </Button>
                <Button
                    Padding="6,4"
                    Click="OnCloneClick"
                    AutomationProperties.Name="Clone"
                    ToolTipService.ToolTip="Clone">
                    <FontIcon FontSize="12" Glyph="&#xE8C8;" />
                </Button>
                <Button
                    x:Name="ConfigureButton"
                    Padding="6,4"
                    Click="OnConfigureClick"
                    AutomationProperties.Name="Configure"
                    ToolTipService.ToolTip="Configure">
                    <FontIcon FontSize="12" Glyph="&#xE713;" />
                </Button>
                <Button
                    Padding="6,4"
                    Click="OnDeleteClick"
                    AutomationProperties.Name="Remove"
                    ToolTipService.ToolTip="Remove">
                    <FontIcon FontSize="12" Glyph="&#xE74D;" />
                </Button>
            </StackPanel>
            <Border
                x:Name="ResizeGrip"
                Width="18"
                Height="18"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Background="Transparent"
                PointerEntered="OnResizeGripEntered"
                PointerExited="OnResizeGripExited"
                PointerPressed="OnResizeGripPressed">
                <FontIcon
                    FontSize="10"
                    Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                    Glyph="&#xE740;" />
            </Border>
        </Grid>
    </Grid>
</UserControl>
