<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="NockMon.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:board="using:NockMon.Board"
    Title="NockMon">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" KeyDown="OnRootKeyDown">
        <Grid.Resources>
            <FontFamily x:Key="FluentIconsFont">ms-appx:///Assets/Icons/FluentSystemIcons-Regular.ttf#FluentSystemIcons-Regular</FontFamily>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="Toolbar"
            Padding="8,6"
            ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel x:Name="BrowsePanel" Orientation="Horizontal" Spacing="8">
                <ComboBox
                    x:Name="LayoutPicker"
                    MinWidth="200"
                    PlaceholderText="Layout"
                    SelectionChanged="OnLayoutPickerSelectionChanged" />
                <DropDownButton ToolTipService.ToolTip="Manage layouts">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="Manage" />
                        <FontIcon FontSize="14" Glyph="&#xE712;" />
                    </StackPanel>
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedLeft">
                            <MenuFlyoutItem Click="OnNewLayoutClick" Text="New empty layout…">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE710;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Click="OnDuplicateLayoutClick" Text="Duplicate…">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8C8;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Click="OnRenameLayoutClick" Text="Rename…">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8AC;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Click="OnAddTabClick" Text="Add tab…">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE737;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Click="OnDeleteLayoutClick" Text="Delete…">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE74D;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
                <Button AutomationProperties.Name="Edit" Click="OnEditClick" ToolTipService.ToolTip="Edit layout (move, resize, add, remove widgets)">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="14" Glyph="&#xE70F;" />
                        <TextBlock Text="Edit" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <StackPanel
                x:Name="EditPanel"
                Orientation="Horizontal"
                Spacing="8"
                Visibility="Collapsed">
                <DropDownButton>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="14" Glyph="&#xE710;" />
                        <TextBlock Text="Add widget" />
                    </StackPanel>
                    <DropDownButton.Flyout>
                        <MenuFlyout x:Name="AddWidgetMenu" Opening="OnAddWidgetMenuOpening" Placement="BottomEdgeAlignedLeft" />
                    </DropDownButton.Flyout>
                </DropDownButton>
                <Button Click="OnDoneClick" Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="14" Glyph="&#xE73E;" />
                        <TextBlock Text="Done" />
                    </StackPanel>
                </Button>
                <Button Click="OnCancelClick" Content="Cancel" />
                <TextBlock
                    x:Name="EditHint"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="Drag to move, drag the corner to resize, gear to configure." />
            </StackPanel>

            <StackPanel
                Grid.Column="2"
                Orientation="Horizontal"
                Spacing="8">
                <!-- Toolbar icons: all from Fluent UI System Icons (font shipped for the tab icons), same size. -->
                <Button
                    AutomationProperties.Name="Plugins"
                    Click="OnPluginsClick"
                    ToolTipService.ToolTip="Plugins: browse, install, update and develop widget plugins">
                    <FontIcon FontFamily="{StaticResource FluentIconsFont}" FontSize="16" Glyph="&#xE9E9;" />
                </Button>
                <!-- AI agents (MCP): the icon takes the accent color while an agent is connected. -->
                <Button
                    x:Name="AgentsButton"
                    AutomationProperties.Name="AI agents"
                    Click="OnAgentsClick">
                    <FontIcon x:Name="AgentsIcon" FontFamily="{StaticResource FluentIconsFont}" FontSize="16" Glyph="&#xF6A5;" />
                </Button>
                <ToggleButton
                    x:Name="TopmostButton"
                    AutomationProperties.Name="Always on top"
                    Click="OnTopmostClick"
                    ToolTipService.ToolTip="Always on top">
                    <FontIcon FontFamily="{StaticResource FluentIconsFont}" FontSize="16" Glyph="&#xF601;" />
                </ToggleButton>
                <Button AutomationProperties.Name="Settings" ToolTipService.ToolTip="Settings: CPU display, sampling and scan intervals">
                    <FontIcon FontFamily="{StaticResource FluentIconsFont}" FontSize="16" Glyph="&#xF6A9;" />
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedRight">
                            <StackPanel Width="340" Spacing="6">
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Settings" />
                                <ComboBox
                                    x:Name="CpuScalePicker"
                                    Margin="0,6,0,0"
                                    HorizontalAlignment="Stretch"
                                    Header="CPU values"
                                    SelectionChanged="OnCpuScaleChanged">
                                    <ComboBoxItem Content="% of total" Tag="Machine" />
                                    <ComboBoxItem Content="Logical CPUs used" Tag="Cpus" />
                                </ComboBox>
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="% of total: 100% = all logical processors busy (Task Manager). Logical CPUs: 1.00 = one fully busy."
                                    TextWrapping="Wrap" />
                                <ComboBox
                                    x:Name="IntervalPicker"
                                    Margin="0,6,0,0"
                                    HorizontalAlignment="Stretch"
                                    Header="Sample interval"
                                    SelectionChanged="OnIntervalChanged">
                                    <ComboBoxItem Content="250 ms" Tag="250" />
                                    <ComboBoxItem Content="500 ms" Tag="500" />
                                    <ComboBoxItem Content="1 s" Tag="1000" />
                                    <ComboBoxItem Content="2 s" Tag="2000" />
                                    <ComboBoxItem Content="5 s" Tag="5000" />
                                </ComboBox>
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="System, per-CPU and watched processes (those used by charts and values)."
                                    TextWrapping="Wrap" />
                                <ComboBox
                                    x:Name="ScanPicker"
                                    Margin="0,6,0,0"
                                    HorizontalAlignment="Stretch"
                                    Header="Process scan interval"
                                    SelectionChanged="OnScanIntervalChanged">
                                    <ComboBoxItem Content="1 s" Tag="1000" />
                                    <ComboBoxItem Content="2 s" Tag="2000" />
                                    <ComboBoxItem Content="5 s" Tag="5000" />
                                    <ComboBoxItem Content="10 s" Tag="10000" />
                                </ComboBox>
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="Full process scan: process tables and history of unwatched processes (~13 ms per scan)."
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Margin="0,6,0,0"
                                    Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="Changing an interval clears the history."
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1">
            <InfoBar
                x:Name="Info"
                Margin="8,0,8,4"
                IsOpen="False" />
            <!-- Kernel events (ETW) off or losing events: its own bar, the other one is reused and closed by many actions. -->
            <InfoBar
                x:Name="EtwInfo"
                Margin="8,0,8,4"
                IsOpen="False" />
        </StackPanel>

        <!-- Column 0: the tab rail (created in code), shown when the layout has several pages or in edit mode. -->
        <Grid x:Name="BoardArea" Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
        <board:BoardView
            x:Name="Board"
            Grid.Column="1"
            DoubleTapped="OnBoardDoubleTapped"
            LayoutEdited="OnBoardLayoutEdited"
            PointerCaptureLost="OnBoardPointerReleased"
            PointerMoved="OnBoardPointerMoved"
            PointerPressed="OnBoardPointerPressed"
            PointerReleased="OnBoardPointerReleased"
            WidgetConfigChanged="OnWidgetConfigChanged" />
        </Grid>
    </Grid>
</Window>
