<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>NockMon</RootNamespace>
    <AssemblyName>NockMon</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <UseWinUI>true</UseWinUI>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <WindowsPackageType>None</WindowsPackageType>
    <!-- Self-contained WinAppSDK requires a RID (build with -r win-x64 / win-arm64). -->
    <WindowsAppSDKSelfContained Condition="'$(RuntimeIdentifier)' != ''">true</WindowsAppSDKSelfContained>
    <!-- Custom Main: elevation gate must run before any XAML initialization. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <!-- -p:ProfilingBuild=true: optimized build that honors NOCKMON_SKIP_ELEVATION (profilers run non-elevated). Never ship it. -->
    <DefineConstants Condition="'$(ProfilingBuild)' == 'true'">$(DefineConstants);ELEVATION_BYPASS</DefineConstants>
    <!-- Not packable itself: shipped as the payload of NockMon.Launcher (dotnet tool). -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Component packages instead of the Microsoft.WindowsAppSDK meta-package: avoids ~45 MB of AI/ML/Search payload. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.6.4" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" Version="2.6.4" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.4.0" />
  </ItemGroup>

  <!-- Fluent UI System Icons (MIT, Microsoft): tab icons. The font ships as a file; the name map is embedded. -->
  <ItemGroup>
    <Content Include="Assets\Icons\FluentSystemIcons-Regular.ttf" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\Icons\LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <EmbeddedResource Include="Assets\Icons\fluent-icons.txt" LogicalName="FluentIcons.txt" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NockMon.Core\NockMon.Core.csproj" />
    <!-- RID-agnostic library: without the per-RID publish folder, the launcher's parallel win-x64/win-arm64 publishes build it once. -->
    <ProjectReference Include="..\NockMon.Sdk\NockMon.Sdk.csproj" GlobalPropertiesToRemove="PublishDir" />
  </ItemGroup>

  <!-- Unpackaged publish omits the project .pri (compiled XAML + resources); the MSIX tooling only ships it in packages. -->
  <Target Name="PublishProjectPri" BeforeTargets="ComputeResolvedFilesToPublishList" Condition="'$(AppxPackage)' != 'true'">
    <ItemGroup>
      <ResolvedFileToPublish Include="$(ProjectPriFullPath)" RelativePath="$(ProjectPriFileName)" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

</Project>
