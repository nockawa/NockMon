<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MyCpuMonitor.Board.BoardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer
        x:Name="Scroller"
        HorizontalScrollBarVisibility="Auto"
        HorizontalScrollMode="Auto"
        SizeChanged="OnScrollerSizeChanged"
        VerticalScrollBarVisibility="Auto"
        VerticalScrollMode="Auto"
        ZoomMode="Disabled">
        <Canvas x:Name="Surface" Background="Transparent">
            <Path x:Name="GridLines" Fill="{ThemeResource SubtleFillColorSecondaryBrush}" Visibility="Collapsed" />
            <Rectangle
                x:Name="Preview"
                Canvas.ZIndex="100"
                IsHitTestVisible="False"
                RadiusX="6"
                RadiusY="6"
                StrokeThickness="2"
                Visibility="Collapsed" />
        </Canvas>
    </ScrollViewer>
</UserControl>
