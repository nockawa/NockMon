<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MyCpuMonitor.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:board="using:MyCpuMonitor.Board"
    Title="My CPU Monitor">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" KeyDown="OnRootKeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="Toolbar"
            Padding="8,6"
            ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel x:Name="BrowsePanel" Orientation="Horizontal" Spacing="8">
                <ComboBox
                    x:Name="LayoutPicker"
                    MinWidth="200"
                    PlaceholderText="Layout"
                    SelectionChanged="OnLayoutPickerSelectionChanged" />
                <DropDownButton ToolTipService.ToolTip="Manage layouts">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="Manage" />
                        <FontIcon FontSize="14" Glyph="&#xE712;" />
                    </StackPanel>
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedLeft">
                            <MenuFlyoutItem Click="OnNewLayoutClick" Text="New empty layout…">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE710;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Click="OnDuplicateLayoutClick" Text="Duplicate…">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8C8;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Click="OnRenameLayoutClick" Text="Rename…">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8AC;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Click="OnAddTabClick" Text="Add tab…">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE737;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Click="OnDeleteLayoutClick" Text="Delete…">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE74D;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
                <Button AutomationProperties.Name="Edit" Click="OnEditClick" ToolTipService.ToolTip="Edit layout (move, resize, add, remove widgets)">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="14" Glyph="&#xE70F;" />
                        <TextBlock Text="Edit" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <StackPanel
                x:Name="EditPanel"
                Orientation="Horizontal"
                Spacing="8"
                Visibility="Collapsed">
                <DropDownButton>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="14" Glyph="&#xE710;" />
                        <TextBlock Text="Add widget" />
                    </StackPanel>
                    <DropDownButton.Flyout>
                        <MenuFlyout x:Name="AddWidgetMenu" Opening="OnAddWidgetMenuOpening" Placement="BottomEdgeAlignedLeft" />
                    </DropDownButton.Flyout>
                </DropDownButton>
                <Button Click="OnDoneClick" Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="14" Glyph="&#xE73E;" />
                        <TextBlock Text="Done" />
                    </StackPanel>
                </Button>
                <Button Click="OnCancelClick" Content="Cancel" />
                <TextBlock
                    x:Name="EditHint"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="Drag to move, drag the corner to resize, gear to configure." />
            </StackPanel>

            <StackPanel
                Grid.Column="2"
                Orientation="Horizontal"
                Spacing="8">
                <TextBlock
                    x:Name="StatusText"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}" />
                <Button
                    AutomationProperties.Name="Plugins"
                    Click="OnPluginsClick"
                    ToolTipService.ToolTip="Plugins: browse, install, update and develop widget plugins">
                    <FontIcon FontSize="14" Glyph="&#xEA86;" />
                </Button>
                <ToggleButton
                    x:Name="TopmostButton"
                    Click="OnTopmostClick"
                    ToolTipService.ToolTip="Always on top">
                    <FontIcon FontSize="14" Glyph="&#xE718;" />
                </ToggleButton>
                <ComboBox
                    x:Name="CpuScalePicker"
                    MinWidth="170"
                    SelectionChanged="OnCpuScaleChanged"
                    ToolTipService.ToolTip="% of total: 100% = all logical processors busy (Task Manager). CPUs: logical processors used, 1.00 = one fully busy.">
                    <ComboBoxItem Content="CPU: % of total" Tag="Machine" />
                    <ComboBoxItem Content="CPU: CPUs" Tag="Cpus" />
                </ComboBox>
                <ComboBox
                    x:Name="IntervalPicker"
                    MinWidth="100"
                    SelectionChanged="OnIntervalChanged"
                    ToolTipService.ToolTip="Sample interval: system, per-CPU and watched processes (those used by charts and values). Changing it clears the history.">
                    <ComboBoxItem Content="Sample 250 ms" Tag="250" />
                    <ComboBoxItem Content="Sample 500 ms" Tag="500" />
                    <ComboBoxItem Content="Sample 1 s" Tag="1000" />
                    <ComboBoxItem Content="Sample 2 s" Tag="2000" />
                    <ComboBoxItem Content="Sample 5 s" Tag="5000" />
                </ComboBox>
                <ComboBox
                    x:Name="ScanPicker"
                    MinWidth="100"
                    SelectionChanged="OnScanIntervalChanged"
                    ToolTipService.ToolTip="Full process scan interval: process tables and history of unwatched processes (~13 ms per scan). Changing it clears the history.">
                    <ComboBoxItem Content="Scan 1 s" Tag="1000" />
                    <ComboBoxItem Content="Scan 2 s" Tag="2000" />
                    <ComboBoxItem Content="Scan 5 s" Tag="5000" />
                    <ComboBoxItem Content="Scan 10 s" Tag="10000" />
                </ComboBox>
            </StackPanel>
        </Grid>

        <InfoBar
            x:Name="Info"
            Grid.Row="1"
            Margin="8,0,8,4"
            IsOpen="False" />

        <!-- Column 0: the tab rail (created in code), shown when the layout has several pages or in edit mode. -->
        <Grid x:Name="BoardArea" Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
        <board:BoardView
            x:Name="Board"
            Grid.Column="1"
            DoubleTapped="OnBoardDoubleTapped"
            LayoutEdited="OnBoardLayoutEdited"
            PointerCaptureLost="OnBoardPointerReleased"
            PointerMoved="OnBoardPointerMoved"
            PointerPressed="OnBoardPointerPressed"
            PointerReleased="OnBoardPointerReleased"
            WidgetConfigChanged="OnWidgetConfigChanged" />
        </Grid>
    </Grid>
</Window>
