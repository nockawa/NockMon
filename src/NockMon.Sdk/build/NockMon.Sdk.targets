<Project>

  <!--
    Build: writes nockmon-plugin.json next to the plugin assembly, so the output folder is a loadable plugin
    (nockmon - -plugin <output folder>, or the Plugins dialog's Development tab).
    Pack: the output folder, minus what the host provides, goes under plugin\ in the package.
  -->

  <PropertyGroup>
    <_NockMonManifest>$(OutDir)nockmon-plugin.json</_NockMonManifest>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);_NockMonPluginPayload</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <!--
    The host provides the SDK, the Windows App SDK (projections, bootstrapper, WebView2), Win2D and CsWinRT: not copied to the
    output, so the folder holds only the plugin and its own dependencies. NockMonKeepHostFiles=true disables this.
  -->
  <PropertyGroup>
    <_McmHostPattern>(?i)^(NockMon\.Sdk|Microsoft\.WinUI|Microsoft\.Windows\..+|Microsoft\.WindowsAppRuntime.*|Microsoft\.InteractiveExperiences.*|Microsoft\.Security\.Authentication\.OAuth.*|Microsoft\.Web\.WebView2.*|WebView2Loader|WinRT\.Runtime|Microsoft\.Graphics\.Canvas.*)\.(dll|pdb|xml|winmd|pri)$</_McmHostPattern>
  </PropertyGroup>

  <Target Name="_NockMonDropHostFiles" AfterTargets="ResolveReferences;ResolvePackageAssets" Condition="'$(NockMonKeepHostFiles)' != 'true'">
    <ItemGroup>
      <_McmDrop Include="@(ReferenceCopyLocalPaths)" Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(Filename)%(Extension)', '$(_McmHostPattern)'))" />
      <ReferenceCopyLocalPaths Remove="@(_McmDrop)" />
      <_McmDropRuntime Include="@(RuntimeTargetsCopyLocalItems)" Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(Filename)%(Extension)', '$(_McmHostPattern)'))" />
      <RuntimeTargetsCopyLocalItems Remove="@(_McmDropRuntime)" />
      <_McmDropNative Include="@(NativeCopyLocalItems)" Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(Filename)%(Extension)', '$(_McmHostPattern)'))" />
      <NativeCopyLocalItems Remove="@(_McmDropNative)" />
    </ItemGroup>
  </Target>

  <!-- Writes a flat JSON object of string fields, escaped (a multi-line description or a quote must not break it). -->
  <UsingTask TaskName="_NockMonWriteJson" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <File ParameterType="System.String" Required="true" />
      <Fields ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Fragment" Language="cs"><![CDATA[
        var json = new System.Text.StringBuilder("{\n");
        for (var i = 0; i < Fields.Length; i++)
        {
            json.Append("  \"").Append(Fields[i].ItemSpec).Append("\": \"");
            foreach (var c in Fields[i].GetMetadata("Value"))
            {
                if (c == '"' || c == '\\')
                    json.Append('\\').Append(c);
                else if (c < 0x20)
                    json.Append("\\u").Append(((int)c).ToString("x4"));
                else
                    json.Append(c);
            }
            json.Append(i < Fields.Length - 1 ? "\",\n" : "\"\n");
        }
        json.Append("}\n");
        var text = json.ToString();
        if (!System.IO.File.Exists(File) || System.IO.File.ReadAllText(File) != text)
            System.IO.File.WriteAllText(File, text);
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="_NockMonWriteManifest" AfterTargets="Build">
    <PropertyGroup>
      <_McmTitle>$(Title)</_McmTitle>
      <_McmTitle Condition="'$(_McmTitle)' == ''">$(PackageId)</_McmTitle>
    </PropertyGroup>
    <ItemGroup>
      <_McmField Include="id" Value="$(PackageId)" />
      <_McmField Include="version" Value="$(PackageVersion)" />
      <_McmField Include="assembly" Value="$(TargetFileName)" />
      <_McmField Include="api" Value="$(NockMonPluginApiVersion)" />
      <_McmField Include="title" Value="$(_McmTitle)" />
      <_McmField Include="description" Value="$(Description)" />
      <_McmField Include="authors" Value="$(Authors)" />
      <_McmField Include="projectUrl" Value="$(PackageProjectUrl)" />
    </ItemGroup>
    <_NockMonWriteJson File="$(_NockMonManifest)" Fields="@(_McmField)" />
  </Target>

  <Target Name="_NockMonPluginPayload" DependsOnTargets="_NockMonWriteManifest">
    <ItemGroup>
      <!-- Provided by the host: the SDK, the Windows App SDK and its projections, CsWinRT. -->
      <_McmHostFile Include="$(OutDir)NockMon.Sdk.*;$(OutDir)Microsoft.WinUI.*;$(OutDir)Microsoft.Windows.*;$(OutDir)Microsoft.WindowsAppRuntime*;$(OutDir)Microsoft.InteractiveExperiences.*;$(OutDir)Microsoft.Web.WebView2.*;$(OutDir)WinRT.Runtime.*;$(OutDir)Microsoft.Graphics.Canvas*;$(OutDir)runtimes\**\Microsoft.WindowsAppRuntime*;$(OutDir)runtimes\**\Microsoft.Web.WebView2*;$(OutDir)**\*.winmd" />
      <_McmFile Include="$(OutDir)**\*" Exclude="@(_McmHostFile)" />
      <TfmSpecificPackageFile Include="@(_McmFile)" PackagePath="plugin\%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>
  </Target>

</Project>
