<Project Sdk="Microsoft.NET.Sdk">

  <!--
    dotnet tool entry point. PackAsTool refuses platform TFMs (NETSDK1146), and WinUI requires one,
    so this net10.0 launcher carries the published WinUI app under app\ and starts it elevated.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>nockmon</AssemblyName>
    <RootNamespace>NockMon.Launcher</RootNamespace>

    <PackAsTool>true</PackAsTool>
    <ToolCommandName>nockmon</ToolCommandName>
    <ToolPackageRuntimeIdentifiers>win-x64;win-arm64</ToolPackageRuntimeIdentifiers>
    <RuntimeIdentifiers>$(ToolPackageRuntimeIdentifiers)</RuntimeIdentifiers>
    <PackageId>NockMon</PackageId>
    <Version>0.8.2</Version>
    <Authors>Loïc Baumann</Authors>
    <Description>NockMon - configurable tile-based workstation monitor (Windows only).</Description>
  </PropertyGroup>

  <PropertyGroup>
    <_AppProject>$(MSBuildThisFileDirectory)..\NockMon.App\NockMon.App.csproj</_AppProject>
    <_AppPublishDir>$(BaseIntermediateOutputPath)app\$(Configuration)\$(RuntimeIdentifier)\</_AppPublishDir>
  </PropertyGroup>

  <!-- RID-specific tool packages only: publish the WinUI app and add it to this tool's publish output under app\. -->
  <Target Name="IncludeAppPayload" BeforeTargets="ComputeResolvedFilesToPublishList" Condition="'$(RuntimeIdentifier)' != ''">
    <MSBuild Projects="$(_AppProject)" Targets="Restore" RemoveProperties="TargetFramework"
             Properties="RuntimeIdentifier=$(RuntimeIdentifier);_Restore=1" />
    <MSBuild Projects="$(_AppProject)" Targets="Publish" RemoveProperties="TargetFramework"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=false;Version=$(Version);PublishDir=$([System.IO.Path]::GetFullPath('$(_AppPublishDir)'))" />
    <ItemGroup>
      <_AppPayload Include="$(_AppPublishDir)**\*" />
      <ResolvedFileToPublish Include="@(_AppPayload)"
                             RelativePath="app\%(_AppPayload.RecursiveDir)%(_AppPayload.Filename)%(_AppPayload.Extension)"
                             CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

</Project>
