<Project Sdk="Microsoft.NET.Sdk">

  <!--
    dotnet tool: "nockmon" starts the installed NockMon (installer or winget, in Program Files) and "nockmon mcp" relays
    MCP for AI agents. It does not carry the app: a tool lives in the user's profile, where any non-elevated process
    could modify files that NockMon would then run as administrator.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>nockmon</AssemblyName>
    <RootNamespace>NockMon.Launcher</RootNamespace>

    <PackAsTool>true</PackAsTool>
    <ToolCommandName>nockmon</ToolCommandName>
    <!-- No apphost: the tool's runner is then "dotnet" and the CLI installs an .exe shim. With one (runner "executable") it
         installs a .cmd shim, which MCP clients built on Node.js cannot start without a shell. -->
    <UseAppHost>false</UseAppHost>
    <PackageId>NockMon</PackageId>
    <Version>1.3.0</Version>
    <Authors>Loïc Baumann</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Copyright>Copyright (c) 2026 Loïc Baumann</Copyright>
    <Description>Command line for NockMon, the configurable tile-based system monitor for Windows: starts the installed app, and relays its MCP server to AI agents (nockmon mcp). Install NockMon itself with winget (Nockawa.NockMon) or its installer.</Description>
    <PackageTags>monitor;system-monitor;performance;task-manager;windows;etw;dpc;latency;gpu;winui;mcp</PackageTags>
    <PackageProjectUrl>https://github.com/nockawa/NockMon</PackageProjectUrl>
    <RepositoryUrl>https://github.com/nockawa/NockMon</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\docs\images\icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
