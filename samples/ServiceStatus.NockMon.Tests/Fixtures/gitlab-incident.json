    "incidents": [
      {
        "_id": "6ae96be253636805c01bc4ec",
        "name": "Elevated CI/CD latency on GitLab.com",
        "datetime_open": "2026-11-03T05:06:42.281Z",
        "current_active": true,
        "messages": [
          {
            "details": "We're investigating elevated latency affecting CI/CD on GitLab.com. No user impact has been observed at this time. We'll update as we learn more.",
            "state": 100,
            "status": 300,
            "datetime": "2026-11-03T05:06:42.326Z"
          },
          {
            "details": "Some users may have seen intermittent slowness with CI/CD jobs, including slower job updates and artifact uploads. Latency is recovering and we're continuing to investigate.",
            "state": 100,
            "status": 300,
            "datetime": "2026-11-03T05:27:53.866Z"
          },
          {
            "details": "We've identified a contributing factor to intermittent slowness affecting CI/CD on GitLab.com, including slower job requests, job updates and artifact uploads. We're still investigating the root cause and working to mitigate the issue. ",
            "state": 200,
            "status": 300,
            "datetime": "2026-11-03T06:01:30.813Z"
          },
          {
            "details": "We've applied a mitigation for the intermittent slowness affecting CI/CD on GitLab.com, and performance has returned to normal. We're monitoring to make sure the issue doesn't recur. ",
            "state": 300,
            "status": 300,
            "datetime": "2026-11-03T07:10:53.376Z"
          }
